{
  "name": "xmtp-chat-rn",
  "version": "0.1.0",
  "description": "XMTP 1:1 messaging for React Native — client lifecycle, hooks, and chat primitives.",
  "license": "MIT",
  "author": "Greg Taschuk (https://github.com/gregtaschuk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PyriteShip/xmtp-chat-rn.git"
  },
  "homepage": "https://github.com/PyriteShip/xmtp-chat-rn#readme",
  "bugs": "https://github.com/PyriteShip/xmtp-chat-rn/issues",
  "keywords": [
    "xmtp",
    "react-native",
    "messaging",
    "chat",
    "mls",
    "e2ee",
    "web3",
    "wallet",
    "direct-messages",
    "expo"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/__mocks__",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "bob build",
    "prepare": "bob build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@xmtp/react-native-sdk": "^5.7.0",
    "react": "*",
    "react-native": "*",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-mmkv": "^4.0.0",
    "react-native-quick-base64": "^2.2.2",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-modules-commonjs": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "@xmtp/react-native-sdk": "^5.7.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "jest": "^29.7.0",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-builder-bob": "^0.40.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-quick-base64": "^2.2.2",
    "react-native-vector-icons": "^10.3.0",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.7.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/*.test.{ts,tsx}",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
